# Host/port must stay in sync with dp-music-api-main/src/config/recomender.ts (RECOMMENDER_API_ENDPOINT)
HOST=0.0.0.0
PORT=8006

# Path to the Kaggle "Spotify 1 Million Tracks" CSV (see data/README.md)
DATASET_PATH=data/spotify_dataset.csv

# Where to cache the fitted TF-IDF/scaler/index artifacts so restarts are instant
ARTIFACTS_DIR=data/artifacts

# Row cap used to keep the vector index responsive (see README "Scalability" section)
MAX_TRACKS=150000

# Default number of tracks returned per recommendation request
DEFAULT_TOP_N=20
